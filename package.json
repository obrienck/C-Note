{
  "name": "c-note",
  "productName": "C-Note",
  "version": "0.1.1",
  "description": "C-Note: a hi-fi desktop music player for collectors.",
  "author": "obrienck",
  "homepage": "https://github.com/obrienck/C-Note",
  "repository": {
    "type": "git",
    "url": "https://github.com/obrienck/C-Note.git"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p . --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "music-metadata": "^12.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
